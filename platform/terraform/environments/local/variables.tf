variable "telemetry_enabled" {
  type    = bool
  default = false
}
variable "telemetry_cluster" {
  type    = string
  default = ""
}
variable "postgres_password" {
  description = "Generated profile-local credential; never commit this or local Terraform state."
  type        = string
  sensitive   = true
  validation {
    condition     = can(regex("^[a-f0-9]{64}$", var.postgres_password))
    error_message = "Use make dev-up/dev-update to generate a 64-character hexadecimal local database password."
  }
}

variable "kube_context" {
  description = "Explicit Minikube profile/context; never use an implicit current context."
  type        = string
  default     = "rpp"
  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{0,39}$", var.kube_context))
    error_message = "Use a lowercase Minikube profile, at most 40 characters."
  }
}

variable "kube_config_path" {
  description = "Local kubeconfig file."
  type        = string
  default     = "~/.kube/config"
}

variable "local_images" {
  description = "Catalog module names mapped to locally built, content-tagged images."
  type        = map(string)
  default     = {}
  validation {
    condition     = alltrue([for image in values(var.local_images) : can(regex("^rpp-local/[a-z0-9-]+:dev-[a-f0-9]{16}$", image))])
    error_message = "Local images must use rpp-local/<module>:dev-<16 hex content hash>."
  }
}
variable "external_kafka" {
  description = "Optional shared-network three-cluster Kafka configuration; generated by make multi-up."
  type = object({
    brokers     = string
    password    = string
    certificate = string
  })
  default   = null
  sensitive = true
}
variable "external_database" {
  description = "Shared CNPG writer endpoint; generated only for the full-stack learning lab."
  type = object({
    address     = string
    password    = string
    certificate = string
  })
  default   = null
  sensitive = true
}

variable "application_replicas" {
  description = "Catalog module name to Deployment replicas; defaults to one."
  type        = map(number)
  default     = {}
  validation {
    condition     = alltrue([for count in values(var.application_replicas) : count >= 1 && floor(count) == count])
    error_message = "Application replicas must be positive integers."
  }
}
variable "worker_replicas" {
  type = object({
    relay    = optional(number, 1)
    consumer = optional(number, 1)
  })
  default = {}
  validation {
    condition     = alltrue([for count in values(var.worker_replicas) : count >= 1 && floor(count) == count])
    error_message = "Worker replicas must be positive integers."
  }
}
variable "registry_replicas" {
  type    = number
  default = 1
  validation {
    condition     = var.registry_replicas >= 1 && floor(var.registry_replicas) == var.registry_replicas
    error_message = "Registry replicas must be a positive integer."
  }
}
variable "ingress_replicas" {
  type    = number
  default = 1
  validation {
    condition     = var.ingress_replicas >= 1 && floor(var.ingress_replicas) == var.ingress_replicas
    error_message = "Ingress replicas must be a positive integer."
  }
}
