{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-payment-platform.example/schemas/module.schema.json",
  "title": "Module catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "type", "version", "owners", "dependencies"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "type": {
      "enum": [
        "api",
        "web",
        "analytics",
        "worker",
        "stream-processing",
        "library",
        "contracts",
        "model",
        "knowledge"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
