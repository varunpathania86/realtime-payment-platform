{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-payment-platform.example/schemas/solution.schema.json",
  "title": "Solution catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "solution", "pi", "modules", "registries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "owners"],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "$ref": "#/$defs/stableVersion"
        },
        "owners": {
          "$ref": "#/$defs/owners"
        }
      }
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startDate", "iterations", "iterationLengthDays"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PI-[0-9]{4}\\.[1-9][0-9]*$"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "iterationLengthDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "charts"],
      "properties": {
        "images": {
          "type": "string",
          "pattern": "^ghcr\\.io\\/(?:[a-z0-9][a-z0-9-]*|<owner>)$"
        },
        "charts": {
          "type": "string",
          "pattern": "^oci:\\/\\/ghcr\\.io\\/(?:[a-z0-9][a-z0-9-]*|<owner>)\\/charts$"
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stableVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
