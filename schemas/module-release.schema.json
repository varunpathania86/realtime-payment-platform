{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-payment-platform.example/schemas/module-release.schema.json",
  "title": "Immutable module release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "module", "version", "source", "workflow", "artifacts", "evidence"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "module-release"
    },
    "module": {
      "$ref": "#/$defs/name"
    },
    "version": {
      "$ref": "#/$defs/lifecycleVersion"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "gitTag"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "gitTag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "url"],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "sbom", "provenance", "approvedImpact"],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sbom": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "approvedImpact": {
          "$ref": "#/$defs/impact"
        },
        "qa": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "impact": {
      "enum": ["none", "patch", "minor", "major"]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/lifecycleVersion"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "charts"],
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chart"
          }
        }
      }
    },
    "lifecycleVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-it[1-9][0-9]*(?:-br\\.[a-f0-9]{4}|-rv\\.[1-9][0-9]*)?|-rc[1-9][0-9]*(?:-br\\.[a-f0-9]{4}|-rv\\.[1-9][0-9]*)?)?$"
    }
  }
}
